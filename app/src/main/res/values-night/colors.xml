<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cryonix colours (dark theme). Same names as values/colors.xml -->

    <!-- Brand -->
    <color name="color_primary">#38A3D6</color>
    <color name="color_on_primary">#0B1220</color>

    <!-- Backgrounds -->
    <color name="color_page">#0B1220</color>
    <color name="color_surface">#111827</color>

    <!-- Soft brand colour (behind illustrations) and page dots -->
    <color name="color_primary_soft">#0C2A3F</color>
    <color name="color_dot_inactive">#334155</color>

    <!-- Lines, errors, success -->
    <color name="color_border">#1F2937</color>
    <color name="color_error">#F87171</color>
    <color name="color_success">#4ADE80</color>
    <color name="color_error_soft">#3B1212</color>
    <color name="color_success_soft">#0F2E1B</color>

    <!-- Text -->
    <color name="color_text_primary">#F1F5F9</color>
    <color name="color_text_secondary">#94A3B8</color>

    <!-- Alert levels (a little brighter so they read well on dark) -->
    <color name="color_level_baseline">#94A3B8</color>
    <color name="color_level_advisory">#FACC15</color>
    <color name="color_level_watch">#FB923C</color>
    <color name="color_level_warning">#F87171</color>
    <color name="color_level_all_clear">#4ADE80</color>
</resources>
