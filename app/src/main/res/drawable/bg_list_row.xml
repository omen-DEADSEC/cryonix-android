<?xml version="1.0" encoding="utf-8"?>
<!-- White rounded row with border; blue border when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary_soft" />
            <stroke android:width="2dp" android:color="@color/color_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary_soft" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
