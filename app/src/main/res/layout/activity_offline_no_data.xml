<?xml version="1.0" encoding="utf-8"?>
<!-- A35 Offline / error: no village data saved yet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_32"
    tools:context=".community.OfflineNoDataActivity">

    <FrameLayout
        android:layout_width="@dimen/onboarding_image_circle_size"
        android:layout_height="@dimen/onboarding_image_circle_size"
        android:background="@drawable/bg_onboarding_image_circle">

        <ImageView
            android:layout_width="@dimen/onboarding_image_icon_size"
            android:layout_height="@dimen/onboarding_image_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_offline_map"
            app:tint="@color/color_primary" />
    </FrameLayout>

    <TextView
        style="@style/Cryonix.Text.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center"
        android:text="@string/offline_no_data_title" />

    <TextView
        style="@style/Cryonix.Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="@string/offline_no_data_text"
        android:textSize="@dimen/text_body_large" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOfflineTryAgain"
        style="@style/Cryonix.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_32"
        android:text="@string/offline_try_again" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOfflineSignOut"
        style="@style/Cryonix.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/button_sign_out" />
</LinearLayout>
