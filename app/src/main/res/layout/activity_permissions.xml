<?xml version="1.0" encoding="utf-8"?>
<!-- A05 Permissions: notifications + location -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".signup.PermissionsActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert_bell"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Cryonix.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_notifications_title" />

                <TextView
                    style="@style/Cryonix.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/permissions_notifications_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_circle_size"
                android:layout_height="@dimen/icon_circle_size"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="@dimen/icon_medium"
                    android:layout_height="@dimen/icon_medium"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location"
                    app:tint="@color/color_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Cryonix.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_location_title" />

                <TextView
                    style="@style/Cryonix.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/permissions_location_text" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPermissionsAllow"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/permissions_button_allow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPermissionsNotNow"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/permissions_button_not_now" />
    </LinearLayout>
</LinearLayout>
