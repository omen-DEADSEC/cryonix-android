<?xml version="1.0" encoding="utf-8"?>
<!-- A27 Create alert (officer and admin) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".alerts.CreateAlertActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_alert_lake" />

        <Spinner
            android:id="@+id/spinnerCreateAlertLake"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/create_alert_level" />

        <!-- Radio texts are set in code from AlertLevel.alertLevels() -->
        <RadioGroup
            android:id="@+id/radioGroupCreateAlertLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioCreateAlertLevel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <RadioButton
                android:id="@+id/radioCreateAlertLevel2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <RadioButton
                android:id="@+id/radioCreateAlertLevel3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <RadioButton
                android:id="@+id/radioCreateAlertLevel4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </RadioGroup>

        <TextView
            
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/create_alert_villages" />

        <LinearLayout
            android:id="@+id/layoutCreateAlertVillages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/create_alert_channels" />

        <LinearLayout
            android:id="@+id/layoutCreateAlertChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/create_alert_message_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCreateAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textCreateAlertError"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/color_error"
            android:visibility="gone" />

        <TextView
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/create_alert_two_person_note" />
    </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCreateAlertSend"
        style="@style/Cryonix.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_margin="@dimen/space_24"
        android:text="@string/create_alert_send"
        app:icon="@drawable/ic_send" />
</LinearLayout>
