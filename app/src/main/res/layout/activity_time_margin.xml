<?xml version="1.0" encoding="utf-8"?>
<!-- A25 Evacuation: time margin of each house (EV-02) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".evacuation.TimeMarginActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/textMarginLake"
            style="@style/Cryonix.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/margin_scenario_note" />

        <!-- How the margin is worked out -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:id="@+id/layoutMarginFormula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    style="@style/Cryonix.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/margin_formula"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Totals for all villages -->
        <TextView
            android:id="@+id/textMarginTotals"
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" />

        <LinearLayout
            android:id="@+id/layoutMarginVillages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Cryonix.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_chip"
            android:padding="@dimen/space_16"
            android:text="@string/margin_help_note" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
