<?xml version="1.0" encoding="utf-8"?>
<!-- A22 Lake detail -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".lakes.LakeDetailActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/textLakeDetailLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLakeDetailName"
            style="@style/Cryonix.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" />

        <TextView
            android:id="@+id/textLakeDetailId"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Flag card: only when the lake model flagged the lake -->
        <LinearLayout
            android:id="@+id/layoutLakeDetailFlag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_message_error"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:visibility="gone">

            <TextView
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lake_detail_flag_title"
                android:textColor="@color/color_error"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLakeDetailFlagReason"
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <TextView
                android:id="@+id/textLakeDetailConfidence"
                style="@style/Cryonix.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:id="@+id/layoutLakeDetailInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_8" />
        </com.google.android.material.card.MaterialCardView>

        <!-- LM-05: area history chart -->
        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/lake_detail_history" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.example.cryonix.lakes.AreaChartView
                android:id="@+id/chartLakeDetailArea"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="@dimen/space_16" />
        </com.google.android.material.card.MaterialCardView>

        <!-- LM-05: latest images side by side -->
        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/lake_detail_images" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.cryonix.lakes.LakeOutlineView
                    android:id="@+id/outlineLakeDetailPrevious"
                    android:layout_width="match_parent"
                    android:layout_height="140dp" />

                <TextView
                    android:id="@+id/textLakeDetailImagePrevious"
                    style="@style/Cryonix.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/space_8"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.cryonix.lakes.LakeOutlineView
                    android:id="@+id/outlineLakeDetailLatest"
                    android:layout_width="match_parent"
                    android:layout_height="140dp" />

                <TextView
                    android:id="@+id/textLakeDetailImageLatest"
                    style="@style/Cryonix.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/lake_detail_images_note" />

        <!-- LM-05: notes on glacier, slopes and dam -->
        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/lake_detail_notes" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:id="@+id/layoutLakeDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_8" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textLakeDetailReviewNote"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLakeDetailFlood"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/lake_detail_flood"
            android:visibility="gone"
            app:icon="@drawable/ic_lake" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLakeDetailReview"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/lake_detail_review"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLakeDetailCreateAlert"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/lake_detail_create_alert"
            android:visibility="gone"
            app:icon="@drawable/ic_send" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
