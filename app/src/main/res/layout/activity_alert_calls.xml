<?xml version="1.0" encoding="utf-8"?>
<!-- MN-01 Alert calls and SMS: my numbers, remove, add a family number with a code -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".community.AlertCallsActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calls_intro" />

        <LinearLayout
            android:id="@+id/layoutCallsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textCallsNone"
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/calls_none"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCallsAddMine"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/calls_add_mine"
            android:visibility="gone" />

        <!-- Add a family number -->
        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/calls_add_title" />

        <TextView
            android:id="@+id/textCallsAddText"
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCallsName"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/calls_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCallsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCallsNumber"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/calls_number_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCallsNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="13"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCallsSendCode"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/calls_send_code" />

        <!-- After "Send code" -->
        <LinearLayout
            android:id="@+id/layoutCallsCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textCallsCodeSent"
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutCallsCode"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/calls_code_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCallsCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCallsVerify"
                style="@style/Cryonix.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/calls_verify" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
