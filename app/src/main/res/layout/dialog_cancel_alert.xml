<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: reason for cancelling an alert -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_24">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutCancelReason"
        style="@style/Cryonix.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/delivery_cancel_reason_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCancelReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
