<?xml version="1.0" encoding="utf-8"?>
<!-- LR-06 Alert text from the village node without internet (Bluetooth broadcast or local Wi-Fi page) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".community.NodeMessageActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/node_message_text"
            android:textSize="@dimen/text_body_large" />

        <!-- Received message -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNodeMessage"
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/textNodeMessageLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNodeMessageBody"
                    style="@style/Cryonix.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />

                <TextView
                    android:id="@+id/textNodeMessageTime"
                    style="@style/Cryonix.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textNodeMessageStatus"
            style="@style/Cryonix.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNodeMessageScan"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/node_message_scan"
            app:icon="@drawable/ic_node" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNodeMessageWifi"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/node_message_wifi" />

        <TextView
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/node_message_wifi_help" />

        <TextView
            android:id="@+id/textNodeMessageSample"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/node_message_sample"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
