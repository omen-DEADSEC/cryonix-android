<?xml version="1.0" encoding="utf-8"?>
<!-- A02 Onboarding screen: 3 pages that explain the app before sign-in -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutOnboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    tools:context=".onboarding.OnboardingActivity">

    <!-- Middle part: picture, title and text (centred in the free space) -->
    <LinearLayout
        android:id="@+id/layoutOnboardingContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layoutOnboardingImage"
            android:layout_width="@dimen/onboarding_image_circle_size"
            android:layout_height="@dimen/onboarding_image_circle_size"
            android:background="@drawable/bg_onboarding_image_circle">

            <ImageView
                android:id="@+id/imageOnboardingIcon"
                android:layout_width="@dimen/onboarding_image_icon_size"
                android:layout_height="@dimen/onboarding_image_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/onboarding_image_description"
                android:src="@drawable/ic_alert_bell"
                app:tint="@color/color_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/textOnboardingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:gravity="center"
            android:text="@string/onboarding_page1_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOnboardingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/onboarding_page1_text"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body_large" />

        <!-- Page dots: the dot of the open page is long and blue -->
        <LinearLayout
            android:id="@+id/layoutOnboardingDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewOnboardingDot1"
                android:layout_width="@dimen/onboarding_dot_active_width"
                android:layout_height="@dimen/onboarding_dot_size"
                android:background="@drawable/bg_onboarding_dot_active" />

            <View
                android:id="@+id/viewOnboardingDot2"
                android:layout_width="@dimen/onboarding_dot_size"
                android:layout_height="@dimen/onboarding_dot_size"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_onboarding_dot_inactive" />

            <View
                android:id="@+id/viewOnboardingDot3"
                android:layout_width="@dimen/onboarding_dot_size"
                android:layout_height="@dimen/onboarding_dot_size"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_onboarding_dot_inactive" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom part: Next button and Skip -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonOnboardingNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:backgroundTint="@color/color_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/onboarding_button_next"
        android:textAllCaps="false"
        android:textColor="@color/color_on_primary"
        android:textSize="@dimen/text_body_large"
        android:textStyle="bold"
        app:cornerRadius="@dimen/radius_control" />

    <TextView
        android:id="@+id/textOnboardingSkip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_8"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/onboarding_button_skip"
        android:textColor="@color/color_primary"
        android:textSize="@dimen/text_body_large" />

</LinearLayout>
