<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar used by most screens: back arrow + title. Set up with TopBarHelper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutTopBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height"
    android:background="@color/color_page"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_4"
    android:paddingEnd="@dimen/space_16">

    <ImageButton
        android:id="@+id/buttonTopBarBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/button_back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/color_text_primary" />

    <TextView
        android:id="@+id/textTopBarTitle"
        style="@style/Cryonix.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/text_title" />
</LinearLayout>
