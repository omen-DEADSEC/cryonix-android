<?xml version="1.0" encoding="utf-8"?>
<!-- Staff bottom bar: Home, Lakes, Alerts, More. Set up with StaffBottomBarHelper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_bottom_bar"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tabStaffHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageTabStaffHome"
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home" />

        <TextView
            android:id="@+id/textTabStaffHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_home"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabStaffLakes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageTabStaffLakes"
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lake" />

        <TextView
            android:id="@+id/textTabStaffLakes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_lakes"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabStaffAlerts"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageTabStaffAlerts"
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alert_bell" />

        <TextView
            android:id="@+id/textTabStaffAlerts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_alerts"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabStaffMore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageTabStaffMore"
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_more" />

        <TextView
            android:id="@+id/textTabStaffMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tab_more"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

</LinearLayout>
