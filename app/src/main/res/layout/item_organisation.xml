<?xml version="1.0" encoding="utf-8"?>
<!-- One organisation row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_list_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <FrameLayout
        android:layout_width="@dimen/icon_circle_size"
        android:layout_height="@dimen/icon_circle_size"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:layout_width="@dimen/icon_medium"
            android:layout_height="@dimen/icon_medium"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_organisation"
            app:tint="@color/color_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textOrganisationName"
            style="@style/Cryonix.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOrganisationType"
            style="@style/Cryonix.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            android:id="@+id/textOrganisationValleys"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>
</LinearLayout>
