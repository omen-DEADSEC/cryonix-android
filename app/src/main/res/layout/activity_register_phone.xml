<?xml version="1.0" encoding="utf-8"?>
<!-- A07 Register phone: number, then 6-digit code -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".signup.RegisterPhoneActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_phone_text" />

        <TextView
            android:id="@+id/textRegisterPhoneVillage"
            style="@style/Cryonix.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutRegisterPhoneNumber"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/register_phone_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="13"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRegisterPhoneSendCode"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/register_phone_send_code" />

        <!-- Shown only after "Send code" -->
        <LinearLayout
            android:id="@+id/layoutRegisterPhoneCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textRegisterPhoneCodeSent"
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Cryonix.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/register_phone_demo_code" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutRegisterPhoneCode"
                style="@style/Cryonix.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:hint="@string/register_phone_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRegisterPhoneCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRegisterPhoneVerify"
                style="@style/Cryonix.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/register_phone_verify" />

            <TextView
                android:id="@+id/textRegisterPhoneResend"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="?attr/selectableItemBackground"
                android:enabled="false"
                android:gravity="center"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
