<?xml version="1.0" encoding="utf-8"?>
<!-- A30 Node detail (LR-08): position, battery and signal over time, last messages -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".network.NodeDetailActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/textNodeDetailName"
            style="@style/Cryonix.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textNodeDetailRepair"
            style="@style/Cryonix.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_message_error"
            android:padding="@dimen/space_16"
            android:text="@string/node_detail_repair"
            android:textColor="@color/color_error"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:id="@+id/layoutNodeDetailInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_8" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/node_detail_battery_chart" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.example.cryonix.lakes.AreaChartView
                android:id="@+id/chartNodeBattery"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="@dimen/space_16" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/node_detail_signal_chart" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.example.cryonix.lakes.AreaChartView
                android:id="@+id/chartNodeSignal"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="@dimen/space_16" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/node_detail_messages" />

        <LinearLayout
            android:id="@+id/layoutNodeDetailMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
