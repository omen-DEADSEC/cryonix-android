<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog: add organisation (name, type, valleys) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_24">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/organisations_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editAddOrganisationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/organisations_type_label" />

        <Spinner
            android:id="@+id/spinnerAddOrganisationType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/organisation_types" />

        <TextView
            style="@style/Cryonix.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/organisations_valleys_label" />

        <LinearLayout
            android:id="@+id/layoutAddOrganisationValleys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textAddOrganisationError"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/organisations_error"
            android:textColor="@color/color_error"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
