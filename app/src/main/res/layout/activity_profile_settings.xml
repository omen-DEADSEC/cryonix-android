<?xml version="1.0" encoding="utf-8"?>
<!-- A34 Profile and settings (AC-11). Same screen for every role; parts hide by role. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".profile.ProfileSettingsActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_details" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutProfileName"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/profile_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutProfilePhone"
            style="@style/Cryonix.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:hint="@string/profile_phone_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="13"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Staff only -->
        <LinearLayout
            android:id="@+id/layoutProfileStaffDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textProfileEmail"
                style="@style/Cryonix.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/textProfileRole"
                style="@style/Cryonix.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProfileChangePassword"
                style="@style/Cryonix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_change_password" />
        </LinearLayout>

        <!-- Community only -->
        <LinearLayout
            android:id="@+id/layoutProfileCommunityDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textProfileVillage"
                style="@style/Cryonix.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProfileChangeVillage"
                style="@style/Cryonix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/profile_change_village"
                app:icon="@drawable/ic_location" />

            <!-- MN-01 numbers for alert calls -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProfileAlertCalls"
                style="@style/Cryonix.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/calls_open"
                app:icon="@drawable/ic_speaker" />
        </LinearLayout>

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_notifications" />

        <LinearLayout
            android:id="@+id/layoutProfileNotifyAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_list_row"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_notify_alerts" />
            <TextView
                style="@style/Cryonix.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_notify_alerts_text" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProfileNotifyAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8" />
        </LinearLayout>

        <!-- Staff only notification options -->
        <LinearLayout
            android:id="@+id/layoutProfileStaffNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutProfileNotifyLakeSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_list_row"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_notify_lake_summary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProfileNotifyLakeSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProfileNotifyNodeHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_list_row"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_notify_node_health" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProfileNotifyNodeHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProfileNotifyEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_list_row"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_row_min_height"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                style="@style/Cryonix.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_notify_email" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchProfileNotifyEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/profile_appearance" />

        <!-- DR-06 light / dark theme -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileTheme"
            style="@style/Cryonix.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_16"
            app:icon="@drawable/ic_theme" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileSave"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/button_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileSignOut"
            style="@style/Cryonix.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/button_sign_out"
            app:icon="@drawable/ic_sign_out" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
