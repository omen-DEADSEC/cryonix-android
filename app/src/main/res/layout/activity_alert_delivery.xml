<?xml version="1.0" encoding="utf-8"?>
<!-- A28 Alert delivery: channels, village confirmations, cancel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".alerts.AlertDeliveryActivity">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textDeliveryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDeliveryStatus"
                style="@style/Cryonix.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/space_8"
                android:paddingBottom="2dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDeliveryLake"
            style="@style/Cryonix.Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" />

        <TextView
            android:id="@+id/textDeliverySentBy"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textDeliveryMessage"
            style="@style/Cryonix.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_list_row"
            android:padding="@dimen/space_16" />

        <TextView
            android:id="@+id/textDeliveryCancelNote"
            style="@style/Cryonix.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone" />

        <TextView
            
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/delivery_channels" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Cryonix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <LinearLayout
                android:id="@+id/layoutDeliveryChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_8" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textDeliveryVillagesTitle"
            style="@style/Cryonix.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24" />

        <LinearLayout
            android:id="@+id/layoutDeliveryVillages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- AL-05: All clear to the same people on the same channels -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeliveryAllClear"
            style="@style/Cryonix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/delivery_all_clear"
            android:visibility="gone"
            app:icon="@drawable/ic_level_all_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeliveryCancel"
            style="@style/Cryonix.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/delivery_cancel"
            android:visibility="gone" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
