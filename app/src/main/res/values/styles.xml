<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles, so every screen looks the same. Change a style here to change all screens. -->
<resources>

    <!-- Main blue button -->
    <style name="Cryonix.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_control</item>
    </style>

    <!-- Button with a border only -->
    <style name="Cryonix.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_control</item>
    </style>

    <!-- Red button with a border (reject, switch off) -->
    <style name="Cryonix.Button.Danger" parent="Cryonix.Button.Outlined">
        <item name="strokeColor">@color/color_error</item>
        <item name="android:textColor">@color/color_error</item>
    </style>

    <!-- Text field with a border -->
    <style name="Cryonix.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
    </style>

    <!-- White card with a thin border -->
    <style name="Cryonix.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text styles -->
    <!-- Empty base styles so the dotted names below have a parent -->
    <style name="Cryonix" />
    <style name="Cryonix.Text" />

    <style name="Cryonix.Text.Heading">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Cryonix.Text.Title">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Cryonix.Text.Body">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Cryonix.Text.Secondary">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Cryonix.Text.Caption">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- Small coloured label, for example the role chip -->
    <style name="Cryonix.Text.Chip">
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
