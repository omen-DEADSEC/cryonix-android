    <!-- A19 Safety guide (CA-09) -->
    <string name="guide_title">Safety guide</string>
    <string name="guide_intro">Read this now, before any danger. It works without internet.</string>
    <string name="guide_step1_title">1. Keep a ready bag</string>
    <string name="guide_step1_text">Water, dry food, medicines, ID cards, a torch, warm clothes and a phone charger.</string>
    <string name="guide_step2_title">2. Know your route</string>
    <string name="guide_step2_text">Walk your route to the safe point once with your family, in daylight.</string>
    <string name="guide_step3_title">3. Listen for the alert</string>
    <string name="guide_step3_text">Alerts come on the mosque speaker, by phone call and in this app.</string>
    <string name="guide_step4_title">4. Go uphill, away from the river</string>
    <string name="guide_step4_text">Never walk along the river or cross a bridge during a Warning. Do not stop to take things.</string>
    <string name="guide_step5_title">5. Help others</string>
    <string name="guide_step5_text">Take children, elders and people who cannot walk fast. Tell your neighbours.</string>
    <string name="guide_step6_title">6. Wait for All clear</string>
    <string name="guide_step6_text">Stay at the safe point until you get the All clear message.</string>
    <string name="guide_practice">Practise the alert screen</string>

