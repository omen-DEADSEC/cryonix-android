<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main app theme (light). The dark version is in values-night/themes.xml -->
    <style name="Theme.Cryonix" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_primary</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>
        <item name="android:windowBackground">@color/color_page</item>

        <!-- Status bar same colour as the page, with dark icons -->
        <item name="android:statusBarColor">@color/color_page</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Android 12+ system splash: use our page colour so it blends into our splash screen -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/color_page</item>
    </style>
</resources>
